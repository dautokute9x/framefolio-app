NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server only - never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
ALBUM_COOKIE_SECRET=replace-with-a-long-random-secret

# Set to true only while creating the photographer account, then remove.
ALLOW_SIGNUP=false
# Show demo credentials on /login (local demo only, never in production).
SHOW_DEMO_LOGIN=false
